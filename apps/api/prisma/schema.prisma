generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenants
// ---------------------------------------------------------------------------

model Tenant {
  id               String   @id @default(cuid())
  name             String
  subdomain        String   @unique
  logoUrl          String?
  primaryColor     String?
  // Hotel letterhead details used on printed tax invoices — editable via
  // the Settings screen, never hardcoded per AI_RULES.md #1.
  address          String?
  phone            String?
  email            String?
  gstin            String?
  currency         String   @default("INR")
  timezone         String   @default("Asia/Kolkata")
  subscriptionPlan String   @default("standard")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users         User[]
  roles         Role[]
  statuses      Status[]
  roomTypes     RoomType[]
  rooms         Room[]
  guests        Guest[]
  bookings      Booking[]
  paymentMethods PaymentMethod[]
  payments      Payment[]
  taxRules      TaxRule[]
  invoices      Invoice[]
  auditLogs     AuditLog[]
  roomClosures  RoomClosure[]
  bookingCharges BookingCharge[]
  invoiceTemplate InvoiceTemplate?
}

// ---------------------------------------------------------------------------
// Roles & permissions
// ---------------------------------------------------------------------------

// Global catalog of permission codes — not tenant-scoped. New permissions
// are added here as features are built; which ones a role has is entirely
// tenant-configurable via RolePermission.
model Permission {
  id          String @id @default(cuid())
  code        String @unique // e.g. "rooms.edit", "bookings.create"
  description String

  rolePermissions RolePermission[]
}

model Role {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  isSystemRole Boolean  @default(false) // true for the tenant's built-in Admin role
  createdAt    DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  users           User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id                String    @id @default(cuid())
  tenantId          String
  roleId            String
  name              String
  email             String
  passwordHash      String
  isActive          Boolean   @default(true)
  refreshTokenHash  String? // hash of the currently-valid refresh token, rotated on each use
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role     Role   @relation(fields: [roleId], references: [id])

  bookingsCreated Booking[]    @relation("BookingCreatedBy")
  paymentsRecorded Payment[]   @relation("PaymentRecordedBy")
  invoicesGenerated Invoice[]  @relation("InvoiceGeneratedBy")
  invoicesCancelled Invoice[]  @relation("InvoiceCancelledBy")
  auditLogs        AuditLog[]
  roomClosuresCreated RoomClosure[] @relation("RoomClosureCreatedBy")
  bookingChargesCreated BookingCharge[] @relation("BookingChargeCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Dynamic statuses (rooms / bookings / payments)
// ---------------------------------------------------------------------------

model Status {
  id         String  @id @default(cuid())
  tenantId   String
  domain     String // "room" | "booking" | "payment"
  code       String
  label      String
  color      String  @default("#6b7280")
  sortOrder  Int     @default(0)
  isDefault  Boolean @default(false)
  isTerminal Boolean @default(false) // e.g. "Checked-out", "Cancelled", "Refunded"

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms    Room[]
  bookings Booking[]
  payments Payment[]

  @@unique([tenantId, domain, code])
  @@index([tenantId, domain])
}

// ---------------------------------------------------------------------------
// Room types & rooms
// ---------------------------------------------------------------------------

model RoomType {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  basePrice    Decimal  @db.Decimal(10, 2)
  capacity     Int      @default(2)
  amenities    Json?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms  Room[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Room {
  id         String   @id @default(cuid())
  tenantId   String
  roomTypeId String
  statusId   String
  roomNumber String
  floor      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomType RoomType  @relation(fields: [roomTypeId], references: [id])
  status   Status    @relation(fields: [statusId], references: [id])
  bookings Booking[]
  closures RoomClosure[]

  @@unique([tenantId, roomNumber])
  @@index([tenantId])
  @@index([statusId])
}

// A date range during which a room is blocked from availability (e.g. for
// renovation/maintenance) — enforced alongside booking-overlap checks.
model RoomClosure {
  id        String    @id @default(cuid())
  tenantId  String
  roomId    String
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdById String
  createdAt DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room      Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy User   @relation("RoomClosureCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([roomId])
}

// ---------------------------------------------------------------------------
// Guests & bookings
// ---------------------------------------------------------------------------

model Guest {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  phone         String?
  phone2        String? // secondary/alternate contact number
  email         String?
  idProofType   String?
  idProofNumber String?
  address       String?
  companyName   String? // for a B2B tax invoice when the guest travels for business
  gstin         String? // the company's GSTIN, printed alongside companyName on the invoice
  createdAt     DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId])
}

model Booking {
  id              String    @id @default(cuid())
  tenantId        String
  roomId          String
  guestId         String
  statusId        String
  // Shared across the sibling bookings created together as one group
  // booking (one guest, several rooms, one bill) — null for a plain
  // single-room booking.
  groupCode       String?
  checkIn         DateTime
  checkOut        DateTime
  actualCheckIn   DateTime?
  actualCheckOut  DateTime?
  adults          Int       @default(1)
  children        Int       @default(0)
  ratePerNight    Decimal   @db.Decimal(10, 2)
  totalAmount     Decimal   @db.Decimal(10, 2)
  notes           String?
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id])
  guest     Guest    @relation(fields: [guestId], references: [id])
  status    Status   @relation(fields: [statusId], references: [id])
  createdBy User     @relation("BookingCreatedBy", fields: [createdById], references: [id])

  payments Payment[]
  invoices Invoice[]
  charges  BookingCharge[]

  @@index([tenantId])
  @@index([roomId])
  @@index([statusId])
  @@index([tenantId, groupCode])
}

// Ad-hoc line items against a booking's bill — extra charges (food,
// damages, laundry, ...) or a discount/concession. `type` is a small
// structural enum (like Status.domain), not tenant-configurable data.
model BookingCharge {
  id          String   @id @default(cuid())
  tenantId    String
  bookingId   String
  type        String // "charge" | "discount"
  description String
  amount      Decimal  @db.Decimal(10, 2)
  // GST rate applied to this charge's amount (which is GST-inclusive, same
  // convention as Booking.totalAmount) — null/0 for an untaxed charge and
  // always null for a discount, which reduces the taxable room value
  // instead of carrying its own tax.
  taxRatePercent Decimal? @db.Decimal(5, 2)
  createdById String
  createdAt   DateTime @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdBy User    @relation("BookingChargeCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([bookingId])
}

// ---------------------------------------------------------------------------
// Payments (manual, no gateway) & tax
// ---------------------------------------------------------------------------

// Tenant-editable list of ways a guest can pay — "Cash", "UPI", "Card",
// "Bank Transfer", etc. Adding a new method is a data row, not a deploy.
model PaymentMethod {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  code     String
  isActive Boolean @default(true)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Payment {
  id             String   @id @default(cuid())
  tenantId       String
  bookingId      String
  methodId       String
  statusId       String
  amount         Decimal  @db.Decimal(10, 2)
  referenceNote  String? // e.g. UPI transaction id or cheque number, entered by staff
  recordedById   String
  recordedAt     DateTime @default(now())

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking    Booking       @relation(fields: [bookingId], references: [id])
  method     PaymentMethod @relation(fields: [methodId], references: [id])
  status     Status        @relation(fields: [statusId], references: [id])
  recordedBy User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([tenantId])
  @@index([bookingId])
}

model TaxRule {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  ratePercent         Decimal   @db.Decimal(5, 2)
  hsnSacCode          String?
  appliesAboveAmount  Decimal?  @db.Decimal(10, 2)
  appliesBelowAmount  Decimal?  @db.Decimal(10, 2)
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  isActive            Boolean   @default(true)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([tenantId])
}

model Invoice {
  id                 String    @id @default(cuid())
  tenantId           String
  bookingId          String
  invoiceNumber      String
  subtotal           Decimal   @db.Decimal(10, 2)
  taxRuleId          String?
  taxRateSnapshot    Decimal   @db.Decimal(5, 2) @default(0)
  taxAmount          Decimal   @db.Decimal(10, 2) @default(0)
  total              Decimal   @db.Decimal(10, 2)
  generatedById      String
  generatedAt        DateTime  @default(now())
  // Guest/company details (name, contact, ID proof, companyName, gstin) as
  // they stood the moment this invoice was finalized — set once, in
  // finalize (POST /bookings/:id/invoice) and reissue (POST /invoices/:id/
  // cancel), never touched again. Mirrors the tax-figure snapshot below:
  // the printed "Billed To" block on a finalized invoice must never change
  // just because someone edits the Guest row later (e.g. an admin adding a
  // missed GSTIN via guests.routes.js `PATCH /guests/:id`) — correcting a
  // finalized invoice's guest details means cancel+reissue, same as a wrong
  // tax figure. Null on a reserved (not yet finalized) invoice and on any
  // invoice finalized before this column existed — both cases fall back to
  // reading the live Guest row (invoices.routes.js `invoiceView`).
  guestSnapshot      Json?
  // A real, permanent invoice number is reserved the moment a booking is
  // created (bookings.routes.js) — not at checkout — so it's visible on
  // every print from booking onward, per product decision 2026-09-18.
  // isFinalized stays false until checkout recomputes the final taxable
  // figures and locks them in (invoices.routes.js `POST /bookings/:id/
  // invoice`) — that recompute, not the earlier reservation, is the
  // "invoice-generation time" AI_RULES.md #4 means when it says tax is
  // computed using the TaxRule active on that date. subtotal/taxAmount/
  // total before finalization are a preview only, openly labeled
  // "PROVISIONAL BILL" on the printed document.
  isFinalized        Boolean   @default(false)
  // An invoice is never edited or hard-deleted (AI_RULES.md #4 — it's a
  // legally-numbered tax document). A wrong *finalized* one is cancelled —
  // kept forever, number never reused — and reissued as a brand-new invoice
  // in the same transaction (invoices.routes.js `POST /invoices/:id/
  // cancel`). An unfinalized (pre-checkout) one is cancelled automatically
  // if its booking itself is cancelled (bookings.routes.js status route) —
  // otherwise it just keeps following the booking, since nothing about a
  // reserved-but-not-yet-final invoice needs a reissue; the booking is
  // still directly editable.
  isCancelled        Boolean   @default(false)
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  // Set on the *new* invoice created by a cancel+reissue — points back at
  // the invoice it replaces, so the paper trail stays traceable. Unique
  // because a cancelled invoice is reissued at most once, atomically,
  // right when it's cancelled.
  supersedesInvoiceId String? @unique

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking      Booking  @relation(fields: [bookingId], references: [id])
  taxRule      TaxRule? @relation(fields: [taxRuleId], references: [id])
  generatedBy  User     @relation("InvoiceGeneratedBy", fields: [generatedById], references: [id])
  cancelledBy  User?    @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  supersedes   Invoice? @relation("InvoiceSupersedes", fields: [supersedesInvoiceId], references: [id])
  supersededBy Invoice? @relation("InvoiceSupersedes")

  @@unique([tenantId, invoiceNumber])
  // Replaces the old plain @@unique([bookingId]): a booking can now have
  // more than one Invoice row over time (cancelled ones stay for the
  // record), but at most one *active* one. Postgres partial unique indexes
  // aren't expressible in Prisma's schema DSL, so this constraint is
  // created by raw SQL in the
  // 20260918160000_invoice_cancel_reissue migration, not derived from this
  // file — don't expect `prisma migrate dev` to regenerate it from here.
  @@index([bookingId])
  @@index([tenantId])
}

// The tenant's printed invoice design (Invoice Design screen). At most one
// per tenant; no row means every option is at its default. `config` is
// written only through invoiceTemplateSchema and read through
// resolveInvoiceTemplate (packages/shared-schemas/src/invoiceTemplate.js),
// so options added later fill in their defaults on rows saved earlier.
// Presentation only — never snapshotted onto an Invoice, so a reprint uses
// the current design while its figures stay frozen.
model InvoiceTemplate {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String // e.g. "booking.create", "room.status_change"
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
}
